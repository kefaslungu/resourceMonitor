#, python-brace-format
msgid "GPU {gpuNumber}: {memoryInfo}."
msgstr "GPU {gpuNumber}: {memoryInfo}."

#: addon\globalPlugins\resourceMonitor\__init__.py:863
msgid "Unable to get GPU memory information."
msgstr "Unable to get GPU memory information."

#: addon\globalPlugins\resourceMonitor\__init__.py:869
msgid "Announces GPU memory usage. If pressed twice, copies the information to the clipboard."
msgstr "Announces GPU memory usage. If pressed twice, copies the information to the clipboard."

