#: addon\globalPlugins\resourceMonitor\__init__.py:60
msgid "No authentication (Open)"
msgstr "Kimlik doğrulama yok (Açık)"

#: addon\globalPlugins\resourceMonitor\__init__.py:85
#, python-brace-format
msgid "Connected to {}"
msgstr "{} ağına bağlanıldı"

#: addon\globalPlugins\resourceMonitor\__init__.py:95
#, python-brace-format
msgid "Disconnected from {}"
msgstr "{} ağ bağlantısı kesildi"

#: addon\globalPlugins\resourceMonitor\__init__.py:100
msgid "A wireless device has been enabled"
msgstr "Bir kablosuz cihaz etkinleştirildi"

#: addon\globalPlugins\resourceMonitor\__init__.py:106
msgid "A wireless device has been disabled"
msgstr "Bir kablosuz cihaz devre dışı bırakıldı"

#. Translators: Fahrenheit temperature unit symbol appended to a GPU temperature value.
#: addon\globalPlugins\resourceMonitor\__init__.py:230
msgid "degrees Fahrenheit"
msgstr "derece Fahrenheit"

#. Translators: Celsius temperature unit symbol appended to a GPU temperature value.
#: addon\globalPlugins\resourceMonitor\__init__.py:234
msgid "degrees Celsius"
msgstr "santigrat derece"

#. Translators: Shows GPU memory usage (example: 2.00 GB of 8.00 GB used (25%)).
#: addon\globalPlugins\resourceMonitor\__init__.py:250
#, python-brace-format
msgid "{used} of {total} used ({percent}%)"
msgstr "{used} bölü {total} kullanılıyor (%{percent})"

#. Translators: Category title for Resource Monitor settings in NVDA's settings dialog.
#. Translators: The gestures category for this add-on in input gestures dialog (2013.3 or later).
#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: addon\globalPlugins\resourceMonitor\__init__.py:259
#: addon\globalPlugins\resourceMonitor\__init__.py:311
#: addon\globalPlugins\resourceMonitor\__init__.py:415 buildVars.py:21
msgid "Resource Monitor"
msgstr "Kaynak İzleme"

#. Translators: Label for a combo box to select the unit used to report GPU temperature.
#: addon\globalPlugins\resourceMonitor\__init__.py:264
msgid "GPU &temperature unit:"
msgstr "GPU ve sıcaklık birimi:"

#. Translators: An option in the GPU temperature unit combo box.
#: addon\globalPlugins\resourceMonitor\__init__.py:266
msgid "Celsius"
msgstr "Santigrat"

#: addon\globalPlugins\resourceMonitor\__init__.py:266
msgid "Fahrenheit"
msgstr "Fahrenheit"

#. Translators: Presents Windows version (example output: "Windows 10 22H2 (AMD64) build 19045.5247").
#: addon\globalPlugins\resourceMonitor\__init__.py:303
#, python-brace-format
msgid "{winVersion} ({cpuBit}) build {build}"
msgstr "{winVersion} ({cpuBit}) Yapı {build}"

#. Translators: Input help mode message for entering the Resource Monitor command layer.
#: addon\globalPlugins\resourceMonitor\__init__.py:405
msgid "Enter the Resource Monitor command layer."
msgstr ""

#: addon\globalPlugins\resourceMonitor\__init__.py:426
msgid "Presents used ram and average processor load. If pressed twice, copies the information to the clipboard."
msgstr ""

#. Translators: presents the overall summary of resource usage, such as CPU load and RAM usage.
#: addon\globalPlugins\resourceMonitor\__init__.py:433
#, python-brace-format
msgid "{ramPercent}% RAM used, CPU at {cpuPercent}%."
msgstr "yüzde {ramPercent} RAM kullanılan, CPU:  %{cpuPercent}."

#: addon\globalPlugins\resourceMonitor\__init__.py:444
msgid "Presents the average processor load and the load of each core. If pressed twice, copies the information to the clipboard."
msgstr "Ortalama işlemci yükünü ve her çekirdeğin yükünü seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#. Translators: Shows average load of CPU cores (example: core 1, 50%).
#: addon\globalPlugins\resourceMonitor\__init__.py:456
#, python-brace-format
msgid "Core {coreNumber}: {corePercent}%"
msgstr "Çekirdek {coreNumber}: yüzde {corePercent}"

#. Translators: Shows average load of the processor on single-core systems.
#: addon\globalPlugins\resourceMonitor\__init__.py:463
#, python-brace-format
msgid "{avgLoad}% CPU load."
msgstr "%{avgLoad} CPU yükü."

#. Translators: Shows average load of the processor and the load for each core on multi-core systems.
#: addon\globalPlugins\resourceMonitor\__init__.py:466
#, python-brace-format
msgid "{avgLoad}% average CPU load, {cores}."
msgstr "%{avgLoad} ortalama CPU yükü, YUO{cores}."

#: addon\globalPlugins\resourceMonitor\__init__.py:477
msgid "Presents the used and total space for both physical and virtual ram. If pressed twice, copies the information to the clipboard."
msgstr "Hem fiziksel hem de sanal ram için kullanılmakta olan ve toplam alanı seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#. Translators: Shows RAM (physical memory) usage.
#: addon\globalPlugins\resourceMonitor\__init__.py:487
#, python-brace-format
msgid "Physical: {physicalUsed} of {physicalTotal} used ({physicalPercent}%). "
msgstr "Fiziksel: {physicalUsed} bölü {physicalTotal} kullanılıyor (%{physicalPercent}). "

#. Translators: Shows virtual memory usage.
#: addon\globalPlugins\resourceMonitor\__init__.py:495
#, python-brace-format
msgid "Virtual: {virtualUsed} of {virtualTotal} used ({virtualPercent}%)."
msgstr "Sanal: {virtualUsed} bölü {virtualTotal} kullanılıyor (%{virtualPercent})."

#: addon\globalPlugins\resourceMonitor\__init__.py:508
msgid "Presents the used and total space of the fixed (built-in), removable, and mapped network drives on this computer. If pressed twice, copies the information to the clipboard."
msgstr "Bu bilgisayardaki sabit (yerleşik), çıkarılabilir ve eşlenmiş ağ sürücülerinin kullanılan ve toplam alanlarını gösterir. İki kez basıldığında, bilgileri panoya kopyalar."

#. Translators: Reported when a mapped network drive is currently unreachable.
#: addon\globalPlugins\resourceMonitor\__init__.py:536
#, python-brace-format
msgid "{driveName} (network drive): not available."
msgstr "{driveName} (ağ sürücüsü): kullanılamıyor."

#. Translators: word used to describe a mapped network drive.
#: addon\globalPlugins\resourceMonitor\__init__.py:539
msgid "network"
msgstr "ağ"

#. Translators: Shows drive letter, type of drive (fixed, removable, or network),
#. used capacity and total capacity of a drive
#. (example: C drive, ntfs; 40 GB of 100 GB used (40%).
#: addon\globalPlugins\resourceMonitor\__init__.py:544
#, python-brace-format
msgid "{driveName} ({driveType} drive): {usedSpace} of {totalSpace} used ({percent}%)."
msgstr "{driveName} ({driveType} sürücüsü): {totalSpace} alanın {usedSpace}’si kullanıldı ({percent}%)."

#: addon\globalPlugins\resourceMonitor\__init__.py:559
#: addon\globalPlugins\resourceMonitor\__init__.py:566
msgid "No wireless devices"
msgstr "Kablosuz cihaz yok"

#: addon\globalPlugins\resourceMonitor\__init__.py:570
msgid "No wireless connections"
msgstr "Kablosuz bağlantı yok"

#: addon\globalPlugins\resourceMonitor\__init__.py:583
#, python-brace-format
msgid "Connected to {}, signal strength: {}%, security type: {}"
msgstr "{} ile bağlı, sinyal gücü: %{}, güvenlik türü: {}"

#: addon\globalPlugins\resourceMonitor\__init__.py:598
msgid "Announces the system's wireless network name (SSID), connection strength, and security  protocol. If pressed twice, copies the information to the clipboard."
msgstr "Sistemin kablosuz ağ adını (SSID), bağlantı gücünü ve güvenlik protokolünü seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#: addon\globalPlugins\resourceMonitor\__init__.py:614
msgid "Announces the version of Windows you are using. If pressed twice, copies the information to the clipboard."
msgstr "Kullanılmakta olan Windows sürümünü seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#. Translators: system uptime in days.
#: addon\globalPlugins\resourceMonitor\__init__.py:639
#, python-brace-format
msgid "{days:d} day"
msgid_plural "{days:d} days"
msgstr[0] "{days:d} gün"
msgstr[1] "{days:d} gün"

#. Translators: system uptime in hours.
#: addon\globalPlugins\resourceMonitor\__init__.py:643
#, python-brace-format
msgid "{hours:d} hour"
msgid_plural "{hours:d} hours"
msgstr[0] "{hours:d} saat"
msgstr[1] "{hours:d} saat"

#. Translators: system uptime in minutes.
#: addon\globalPlugins\resourceMonitor\__init__.py:647
#, python-brace-format
msgid "{minutes:d} minute"
msgid_plural "{minutes:d} minutes"
msgstr[0] "{minutes:d} dakika"
msgstr[1] "{minutes:d} dakika"

#. Translators: system uptime in seconds.
#: addon\globalPlugins\resourceMonitor\__init__.py:651
#, python-brace-format
msgid "{seconds:d} second"
msgid_plural "{seconds:d} seconds"
msgstr[0] "{seconds:d} saniye"
msgstr[1] "{seconds:d} saniye"

#: addon\globalPlugins\resourceMonitor\__init__.py:658
msgid "Announces the system's uptime. If pressed twice, copies the information to the clipboard."
msgstr "Sistemin çalışma süresini seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#. Translators: Obtaining uptime failed
#: addon\globalPlugins\resourceMonitor\__init__.py:673
msgid "Failed to get the system's uptime."
msgstr "Sistemin açık olduğu zaman bilgisi alınamadı."

#: addon\globalPlugins\resourceMonitor\__init__.py:689
#, python-brace-format
msgid "GPU {gpuNumber}: usage {usage}%, temp {temperature}."
msgstr "GPU {gpuNumber}: kullanım {usage}%, sıcaklık {temperature}."

#: addon\globalPlugins\resourceMonitor\__init__.py:699
#: addon\globalPlugins\resourceMonitor\__init__.py:756
msgid "No GPU information available."
msgstr "GPU bilgisi mevcut değil."

#: addon\globalPlugins\resourceMonitor\__init__.py:701
msgid "Unable to get GPU information."
msgstr "GPU bilgisi alınamıyor."

#: addon\globalPlugins\resourceMonitor\__init__.py:702
#: addon\globalPlugins\resourceMonitor\__init__.py:759
msgid "No GPU data available."
msgstr "GPU verisi yok."

#: addon\globalPlugins\resourceMonitor\__init__.py:707
msgid "Announces GPU usage and temperature. If pressed twice, copies the information to the clipboard."
msgstr "GPU kullanımını ve sıcaklığını seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#. noqa
#. Translators: Message reported when the GPU command fails unexpectedly.
#: addon\globalPlugins\resourceMonitor\__init__.py:722
msgid "Failed to get GPU information."
msgstr "GPU bilgileri alınamadı."

#. Translators: Shows GPU memory usage (example: GPU 1: 2.00 GB of 8.00 GB used (25%)).
#: addon\globalPlugins\resourceMonitor\__init__.py:747
#, python-brace-format
msgid "GPU {gpuNumber}: {memoryInfo}."
msgstr "GPU {gpuNumber}: {memoryInfo}."

#: addon\globalPlugins\resourceMonitor\__init__.py:758
msgid "Unable to get GPU memory information."
msgstr "GPU bellek bilgisi alınamıyor."

#: addon\globalPlugins\resourceMonitor\__init__.py:764
msgid "Announces GPU memory usage. If pressed twice, copies the information to the clipboard."
msgstr "GPU bellek kullanımını seslendirir. İki kez basıldığında bilgiler panoya kopyalanır."

#. noqa
#. Translators: Message reported when the GPU memory command fails unexpectedly.
#: addon\globalPlugins\resourceMonitor\__init__.py:779
msgid "Failed to get GPU memory information."
msgstr "GPU bellek bilgisi alınamadı."

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:24
msgid "A handy resource monitor to report CPU load, memory usage, disk usage status and more."
msgstr "CPU yükünü, bellek kullanımını, disk kullanım durumunu ve daha fazlasını bildirmek için kullanışlı bir kaynak monitörü."

#. Brief changelog for this version
#. Translators: what's new content for the add-on version to be shown in the add-on store
#: buildVars.py:29
msgid "* Introduced Resource Monitor layer commands with overall resource usage command (NVDA+Shift+E) as layer entry command. Layer commands include C (CPU), D (disks), G (GPU)/Shift+G (GPU memory), M (memory/RAM), O (operating system/Windows version), U (system uptime), and W (wi-fi). Press NVDA+Shift+E then Space for overall resource usage information, and Escape to exit the layer. The individual resource usage commands (NVDA+Shift+number row 1 through 7) are kept for limited backward compatibility (contributed by cary-rowen)."
msgstr ""

